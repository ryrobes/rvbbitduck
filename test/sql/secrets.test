# name: test/sql/secrets.test
# description: openrouter secret type and env fallback switch
# group: [sql]

require rvbbit

statement ok
SET rvbbit_ignore_env=true;

statement ok
SET rvbbit_transport='live';

query I
SELECT rvbbit.key_source();
----
none

query I
SELECT rvbbit.secret_configured();
----
false

statement error
SELECT rvbbit.truth('please cancel', 'wants to cancel');
----
OpenRouter API key

statement ok
CREATE SECRET rvbbit_test (TYPE openrouter, KEY 'sk-test-not-used', DECISION_MODEL 'typesafe/jev-1.13');

query I
SELECT rvbbit.key_source();
----
secret

query I
SELECT rvbbit.secret_configured();
----
true

# The key is redacted in the secret catalog.
query I
SELECT secret_string NOT LIKE '%sk-test-not-used%'
FROM duckdb_secrets()
WHERE name = 'rvbbit_test';
----
true
