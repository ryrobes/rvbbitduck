# name: test/sql/aggregates.test
# description: grouped semantic aggregates
# group: [sql]

require rvbbit

statement ok
SET rvbbit_transport='mock';

statement ok
SET rvbbit_ignore_env=true;

statement ok
SET rvbbit_retry_base_ms=1;

statement ok
SELECT rvbbit.cache_purge();

statement ok
SELECT rvbbit.http_log_reset();

statement ok
SELECT rvbbit.ledger_reset();

query II
SELECT region, rvbbit.classify_collection(body, 'billing,shipping,other') AS label
FROM (VALUES
    ('east', 'please refund this billing charge'),
    ('east', 'another billing invoice problem'),
    ('east', 'please refund this billing charge'),
    ('west', 'where is the shipping package')) v(region, body)
GROUP BY region
ORDER BY region;
----
east	billing
west	shipping

# Duplicates in a group share one chat call. Two groups, two calls.
query I
SELECT count(*) FROM rvbbit.http_log() WHERE kind = 'chat';
----
2

query I
SELECT rvbbit.summarize_collection(body) FROM (VALUES ('revenue grew in asia')) t(body);
----
Summary of: - revenue grew in asia

query I
SELECT rvbbit.consensus(body) FROM (VALUES ('please cancel the billing charge'), ('please cancel the billing charge')) t(body);
----
consensus: - please cancel the billing charge

query I
SELECT contains(array_to_string(rvbbit.collection_themes(body), ','), 'Cancellation')
FROM (VALUES ('please cancel the billing problem'), ('please cancel the billing problem')) t(body);
----
true

# NULL inputs do not call the model.
statement ok
SELECT rvbbit.http_log_reset();

query I
SELECT rvbbit.classify_collection(body, 'billing,other') IS NULL FROM (VALUES (NULL)) t(body);
----
true

query I
SELECT count(*) FROM rvbbit.http_log();
----
0

# More than one chunk is reduced. Thirteen distinct texts, chunk size 12.
statement ok
SELECT rvbbit.http_log_reset();

query I
SELECT rvbbit.classify_collection(body, 'billing,other')
FROM (
    SELECT 'billing note ' || i AS body
    FROM range(13) t(i)
);
----
billing

query I
SELECT count(*) >= 2 FROM rvbbit.http_log() WHERE kind = 'chat';
----
true

# GROUP BY: one group, several groups, a short category list, and NULL input.
query II
SELECT g, rvbbit.consensus(b) FROM (VALUES (1, 'a')) t(g, b) GROUP BY g;
----
1	consensus: - a

query II
SELECT g, rvbbit.summarize_collection(b) FROM (VALUES (1, 'a')) t(g, b) GROUP BY g;
----
1	Summary of: - a

query I
SELECT len(rvbbit.collection_themes(b)) > 0 FROM (VALUES (1, 'please cancel the billing problem')) t(g, b) GROUP BY g;
----
true

query II
SELECT g, rvbbit.classify_collection(b, 'x,y') FROM (VALUES (1, 'a'), (2, 'b')) t(g, b) GROUP BY g ORDER BY g;
----
1	x
2	x

query I
SELECT rvbbit.consensus(b) IS NULL AND rvbbit.summarize_collection(b) IS NULL
   AND rvbbit.collection_themes(b) IS NULL AND rvbbit.classify_collection(b, 'x,y') IS NULL
FROM (VALUES (1, NULL)) t(g, b)
GROUP BY g;
----
true

# Enough rows that the hash tables combine across threads.
statement ok
SET threads=4;

query I
SELECT count(*) FROM (
    SELECT g, rvbbit.classify_collection(b, 'x,y') AS label
    FROM (SELECT i % 16 AS g, 'row ' || i AS b FROM range(2000) t(i))
    GROUP BY g
) s
WHERE label IN ('x', 'y');
----
16
